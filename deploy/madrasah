#!/usr/bin/env bash
# Runs the madrasah copies on this server. Lives in /srv/madrasah; see deploy/README.md.
#   ./madrasah add <name> <web address> [--demo]   new madrasah: its own database, keys, app container and HTTPS site
#   ./madrasah update                               build the app from ./src (sent by ship.sh) and restart every madrasah;
#                                                   also keeps the owner dashboard's token, health file and cron in place
#   ./madrasah password <name> <email|--all> [pw]   new password (random unless given) for a sign-in or all, kept in tenants/<name>.passwords
#   ./madrasah restart <name> | logs <name> | list
#   ./madrasah signups [name]                       early-access sign-ups from the homepage (on the main-site copy, "main")
#   ./madrasah messages [name]                      contact-form messages from the main site, newest first
#   ./madrasah owner <email>                        the owner dashboard's account (made, or reset if the phone is lost): prints a setup link
#   ./madrasah backup [name]                        database dumps of every madrasah (or one) into ./backups (nightly from cron)
#   ./madrasah suspend <name> | resume <name>       pause a madrasah (stopped, visitors see a "paused" page) or bring it back
#   ./madrasah remove <name> [--yes]                final backup and keys into ./removed/<name>-<date>, then delete it for good
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
IMAGE=madrasah-app:latest
KEEP_DAYS=14

die() { echo "$*" >&2; exit 1; }
hex() { openssl rand -hex "$1"; }
tenants() { ls tenants/*.env 2>/dev/null | xargs -rn1 basename | sed 's/\.env$//'; }
psql_su() { docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U postgres "$@"; }

start() { # (re)creates one madrasah's app container from the current image
  local n=$1
  docker rm -f "ma-$n" >/dev/null 2>&1 || true
  # shortcut: a few seconds offline while the new container migrates and starts; fine for test schools, use blue/green if that matters
  # The main site's copy reads the server's health for the owner dashboard (written by ./owner-health), read-only.
  local extra=(); grep -q '^MARKETING_SITE=1' "tenants/$n.env" && extra=(-v "$PWD/owner:/owner:ro")
  docker run -d --name "ma-$n" --restart unless-stopped --network madrasah_apps \
    --env-file "tenants/$n.env" -v "ma-$n-files:/data" "${extra[@]}" --memory 900m --memory-swap 1400m "$IMAGE" >/dev/null
  echo "started ma-$n"
}
domain() { sed -n 's|^APP_URL=https://||p' "tenants/$1.env"; }
site() { printf '%s {\n\tencode zstd gzip\n\treverse_proxy ma-%s:3000\n}\n' "$(domain "$1")" "$1" > "sites/$1.caddy"; }
caddy_reload() { docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile; }
madrasah_only() { # a madrasah that exists, never the main site
  [[ -e tenants/${1:-}.env ]] || die "no such madrasah"
  ! grep -q '^MARKETING_SITE=1' "tenants/$1.env" || die "that's the main site"
}
files_tgz() { docker run --rm -v "ma-$1-files:/data:ro" --entrypoint tar "$IMAGE" czf - -C /data .; } # works while it's stopped too

# The owner dashboard (main site) asks each madrasah copy for its counts over the private network with this one token.
owner_token() {
  [[ -s secrets/owner_summary_token ]] || (umask 077; hex 32 > secrets/owner_summary_token)
  cat secrets/owner_summary_token
}
# Every copy has the token, the health file exists, cron rewrites it every 5 minutes and runs the dashboard's safe actions
# every minute. Safe to run again.
owner_setup() {
  local t; t=$(owner_token)
  for n in $(tenants); do grep -q '^OWNER_SUMMARY_TOKEN=' "tenants/$n.env" || echo "OWNER_SUMMARY_TOKEN=$t" >> "tenants/$n.env"; done
  mkdir -p owner
  local line="*/5 * * * * $PWD/owner-health >> $PWD/owner/cron.log 2>&1"
  crontab -l 2>/dev/null | grep -qF "$PWD/owner-health" || (crontab -l 2>/dev/null; echo "$line") | crontab -
  # Restart and back up now, asked for on the dashboard, are picked up within a minute.
  line="* * * * * $PWD/owner-actions >> $PWD/owner/actions.log 2>&1"
  crontab -l 2>/dev/null | grep -qF "$PWD/owner-actions" || (crontab -l 2>/dev/null; echo "$line") | crontab -
  ./owner-health || echo "owner-health failed; the dashboard's Server page will say so" >&2
}

case "${1:-}" in
  add)
    n=${2:-}; domain=${3:-}; demo=${4:-}
    [[ $n =~ ^[a-z0-9][a-z0-9-]{1,29}$ ]] || die "name: 2-30 lowercase letters, digits or dashes"
    [[ $domain =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || die "web address: like raheemi.example.co.uk"
    [[ -e tenants/$n.env ]] && die "$n already exists"
    docker image inspect "$IMAGE" >/dev/null 2>&1 || die "no app image yet: run ship.sh from your computer first"
    db="ma_${n//-/_}"; pw=$(hex 24)
    psql_su <<SQL
create role $db login password '$pw';
create database $db owner $db;
revoke all on database $db from public;
SQL
    umask 077
    {
      echo "DATABASE_URL=postgres://$db:$pw@postgres:5432/$db"
      echo "APP_URL=https://$domain"
      echo "DATA_ENCRYPTION_KEY=$(hex 32)"
      echo "BACKUP_ENCRYPTION_KEY=$(hex 32)"
      echo "TRUST_PROXY=1"
      echo "STORAGE_DRIVER=local"
      echo "STORAGE_LOCAL_DIR=/data"
      echo "EMAIL_DRIVER=log"
      echo "SMS_DRIVER=log"
      echo "PUSH_DRIVER=webpush"
      echo "OWNER_SUMMARY_TOKEN=$(owner_token)"
      if [[ $demo == --demo ]]; then
        echo "SEED_SAMPLE_DATA=1"
        echo "SEED_ADMIN_PASSWORD=$(hex 8)"
      else
        echo "SETUP_CODE=$(hex 6)"
      fi
    } > "tenants/$n.env"
    site "$n"
    start "$n"
    caddy_reload
    echo "$n will be at https://$domain once it has started (about a minute)."
    if [[ $demo == --demo ]]; then
      for _ in $(seq 60); do docker logs "ma-$n" 2>&1 | grep -q 'Ready in' && break; sleep 3; done
      "$0" password "$n" --all # every sample login gets its own password instead of the shared seed one
    else echo "Setup code for its first admin (give it to them, at https://$domain/admin/setup): grep SETUP_CODE $PWD/tenants/$n.env"; fi
    ;;
  update)
    [[ -d src ]] || die "no ./src: run ship.sh from your computer"
    docker build -t "$IMAGE" src
    owner_setup
    for n in $(tenants); do [[ -e tenants/$n.paused ]] || start "$n"; done # a paused one gets the new version when it's resumed
    docker image prune -f >/dev/null
    ;;
  password)
    n=${2:-}; who=${3:-}
    [[ -e tenants/$n.env && -n $who ]] || die "usage: ./madrasah password <madrasah> <email|--all> [password]"
    umask 077; f=tenants/$n.passwords; touch "$f"
    new=$(docker exec "ma-$n" npx tsx scripts/set-password.ts "$who" ${4:+"$4"}) || die "no sign-in found for $who"
    while read -r portal email _; do # replace that sign-in's old line
      awk -v p="$portal" -v e="$email" '!($1 == p && $2 == e)' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    done <<< "$new"
    echo "$new" >> "$f"
    echo "New password set for $(wc -l <<< "$new") sign-in(s), and they were signed out. To see them: cat $PWD/$f"
    ;;
  messages)
    db="ma_${2:-main}"; db=${db//-/_}
    docker compose exec -T postgres psql -U postgres -d "$db" -x -c       "select to_char(created_at at time zone 'Europe/London', 'DD/MM/YYYY HH24:MI') as \"when\", reply_to as \"from\", subject, regexp_replace(regexp_replace(html, '</(tr|p)>', E'\n', 'g'), '<[^>]+>', ' ', 'g') as message from mail_queue where entity = 'contact_message' order by created_at desc" </dev/null
    ;;
  signups)
    db="ma_${2:-main}"; db=${db//-/_}
    docker compose exec -T postgres psql -U postgres -d "$db" -c       "select to_char(created_at at time zone 'Europe/London', 'DD/MM/YYYY HH24:MI') as \"when\", school, name, role, email, students, type from early_access_signup order by created_at desc" </dev/null
    ;;
  owner)
    [[ -n ${2:-} ]] || die "usage: ./madrasah owner <your email>"
    echo "Every device signed in to the owner dashboard is signed out. Open this link within 24 hours to choose a password and add your authenticator:"
    docker exec ma-main npx tsx scripts/owner-setup.ts "$2"
    ;;
  restart) [[ -e tenants/${2:-}.env ]] || die "no such madrasah"; [[ ! -e tenants/$2.paused ]] || die "$2 is paused: resume it instead"; start "$2" ;;
  suspend)
    n=${2:-}; madrasah_only "$n"
    touch "tenants/$n.paused"
    docker stop "ma-$n" >/dev/null 2>&1 || true
    printf '%s {\n\theader Content-Type "text/html; charset=utf-8"\n\theader Cache-Control no-store\n\trespond `<!doctype html><html lang="en-GB"><meta name="viewport" content="width=device-width"><title>Paused</title><body style="font:18px/1.5 system-ui,sans-serif;max-width:32rem;margin:15vh auto;padding:0 16px;color:#1a1f3d"><h1 style="font-size:1.5rem">This madrasah’s system is paused</h1><p>Please contact the madrasah directly for now.</p></body></html>` 503\n}\n' "$(domain "$n")" > "sites/$n.caddy"
    caddy_reload
    echo "Paused $n. Its data stays as it is; ./madrasah resume $n brings it back."
    ;;
  resume)
    n=${2:-}; madrasah_only "$n"
    rm -f "tenants/$n.paused"
    site "$n"; start "$n"; caddy_reload
    echo "Resumed $n."
    ;;
  remove)
    n=${2:-}; madrasah_only "$n"
    if [[ ${3:-} != --yes ]]; then read -rp "Type $n to remove it for good: " typed; [[ $typed == "$n" ]] || die "Not removed."; fi
    umask 077
    keep="removed/$n-$(date +%F-%H%M%S)"; db="ma_${n//-/_}"
    mkdir -p "$keep"
    # The final backup comes first: if any of it fails, set -e stops here and nothing is deleted.
    docker compose exec -T postgres pg_dump -U postgres -Fc "$db" > "$keep/database.dump"
    files_tgz "$n" > "$keep/files.tgz"
    cp "tenants/$n.env" "$keep/"; [[ ! -e tenants/$n.passwords ]] || cp "tenants/$n.passwords" "$keep/"
    [[ -s $keep/database.dump && -s $keep/files.tgz ]] || die "The final backup is empty, so nothing was removed. It's in $keep."
    docker rm -f "ma-$n" >/dev/null 2>&1 || true
    rm -f "sites/$n.caddy"; caddy_reload
    psql_su <<SQL
drop database if exists $db;
drop role if exists $db;
SQL
    docker volume rm "ma-$n-files" >/dev/null 2>&1 || true
    [[ ! -d backups/$n ]] || mv "backups/$n" "$keep/backups"
    rm -f "tenants/$n.env" "tenants/$n.passwords" "tenants/$n.paused"
    echo "Removed $n. Its final backup and keys are in $PWD/$keep (kept until you delete them)."
    ;;
  logs) docker logs --tail 200 -f "ma-${2:?name}" ;;
  list)
    for n in $(tenants); do
      printf '%-24s %-40s %s\n' "$n" "$(sed -n 's/^APP_URL=//p' "tenants/$n.env")" "$(docker inspect -f '{{.State.Status}}' "ma-$n" 2>/dev/null || echo missing)"
    done ;;
  backup)
    umask 077
    names=$(tenants)
    if [[ -n ${2:-} ]]; then [[ -e tenants/$2.env ]] || die "no such madrasah"; names=$2; fi
    for n in $names; do
      mkdir -p "backups/$n"
      docker compose exec -T postgres pg_dump -U postgres -Fc "ma_${n//-/_}" > "backups/$n/$(date +%F).dump"
      files_tgz "$n" > "backups/$n/$(date +%F)-files.tgz"
      find "backups/$n" -type f -mtime +$KEEP_DAYS -delete
    done ;;
  *) sed -n '2,13p' "$0"; exit 1 ;;
esac
