# Copy to .env.local and fill in. Never commit real values.

# Postgres. The test URL must point at a throwaway database whose name contains school_test.
DATABASE_URL=postgres://school_app:CHANGE_ME@localhost:5432/school_dev
DATABASE_URL_TEST=postgres://school_app:CHANGE_ME@localhost:5432/school_test

# Public base URL of the app.
APP_URL=http://localhost:3000

# 32 random bytes (64 hex characters, or base64) for AES-256-GCM encryption of secrets and sensitive fields.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Set to 1 only when a proxy you run sets X-Forwarded-For (used for login rate limiting).
TRUST_PROXY=0

# File storage. Only the local driver exists so far.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Email and SMS stay on the "log" fake until real sending is approved.
# EMAIL_DRIVER: log | smtp. SMS_DRIVER: log | clicksend | voodoo.
EMAIL_DRIVER=log
SMS_DRIVER=log
# System SMTP server (used when Settings → Mail is "System mail server" and EMAIL_DRIVER=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# SMS provider keys (take precedence over Settings → SMS).
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
VOODOO_API_KEY=

# Payment gateways (§4). Use test/sandbox keys only until real payments are approved.
# These take precedence over the keys saved in Settings → Payment gateways.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=
# Tests only: 1 swaps Stripe and GoCardless for fakes. Never set this on a real deployment.
PAYMENTS_FAKE=

# Password given to the fictional seed logins by `npm run db:seed` (dev/test only, 10+ characters).
SEED_ADMIN_PASSWORD=CHANGE_ME
