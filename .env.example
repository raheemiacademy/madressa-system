# Copy to .env.local and fill in. Never commit real values.

# Postgres. The test URL must point at a throwaway database whose name contains school_test.
DATABASE_URL=postgres://school_app:CHANGE_ME@localhost:5432/school_dev
DATABASE_URL_TEST=postgres://school_app:CHANGE_ME@localhost:5432/school_test

# Public base URL of the app.
APP_URL=http://localhost:3000

# 32 random bytes (64 hex characters, or base64) for AES-256-GCM encryption of secrets and sensitive fields.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Set to 1 only when a proxy you run sets X-Forwarded-For (used for login rate limiting).
TRUST_PROXY=0

# File storage. Only the local driver exists so far.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3-compatible storage for uploads and backups (STORAGE_DRIVER=s3). Use a UK-region bucket; files stay private.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Backups (§3) are encrypted with this: 32 bytes as 64 hex characters or base64.
# Keep a copy somewhere safe: without it, backups can't be restored.
BACKUP_ENCRYPTION_KEY=

# Email and SMS stay on the "log" fake until real sending is approved.
# EMAIL_DRIVER: log | smtp. SMS_DRIVER: log | clicksend | voodoo.
EMAIL_DRIVER=log
SMS_DRIVER=log

# Phone notifications (web push) for the parent and teacher apps. PUSH_DRIVER: log (nothing leaves the machine) | webpush.
# VAPID keys identify this school to the push services. Leave them empty and the app makes a pair once and keeps it
# (private half encrypted with DATA_ENCRYPTION_KEY). To make your own: npx web-push generate-vapid-keys
PUSH_DRIVER=log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push services contact about problems: a mailto: address or https URL. Defaults to APP_URL.
VAPID_SUBJECT=
# System SMTP server (used when Settings → Mail is "System mail server" and EMAIL_DRIVER=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# SMS provider keys (take precedence over Settings → SMS).
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
VOODOO_API_KEY=

# Payment gateways (§4). Use test/sandbox keys only until real payments are approved.
# These take precedence over the keys saved in Settings → Payment gateways.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=
# Tests only: 1 swaps Stripe and GoCardless for fakes. Never set this on a real deployment.
PAYMENTS_FAKE=

# Password given to the fictional seed logins by `npm run db:seed` (dev/test only, 10+ characters).
SEED_ADMIN_PASSWORD=CHANGE_ME
# 1 loads the fictional sample school when the server starts (the demo preview only). Leave empty for a real madrasah.
SEED_SAMPLE_DATA=
# A real madrasah starts empty: its first admin account is made at /admin/setup, which asks for this code.
# Choose something long (8+ characters) and give it only to the person setting the madrasah up.
SETUP_CODE=

# Marketing site. Set MARKETING_SITE=1 only on the copy that serves the main domain: / then shows the public homepage
# (with /features, /faq and /contact), POST /api/early-access takes sign-ups and POST /api/contact takes messages, and /owner is the owner
# dashboard (account made with ./madrasah owner). Every madrasah's own copy leaves it unset (/ goes to the admin app; /owner is a 404).
MARKETING_SITE=
# Where each early-access sign-up and contact message is emailed (through the normal mail queue; nothing is sent while EMAIL_DRIVER=log).
EARLY_ACCESS_NOTIFY_EMAIL=
# Owner dashboard. Each copy answers GET /api/owner/summary (counts only) on the server's private network with this token;
# unset, that endpoint doesn't exist. ./madrasah update gives every copy the same one (secrets/owner_summary_token). 32+ characters.
OWNER_SUMMARY_TOKEN=
# Main site only, and only for testing on your own computer: where the server's health file is. Leave unset on the server,
# where ./madrasah mounts it at /owner/health.json (the default).
OWNER_HEALTH_FILE=
