# Copy to .env.local and fill in. Never commit real values.

# Postgres. The test URL must point at a throwaway database whose name contains school_test.
DATABASE_URL=postgres://school_app:CHANGE_ME@localhost:5432/school_dev
DATABASE_URL_TEST=postgres://school_app:CHANGE_ME@localhost:5432/school_test

# Public base URL of the app.
APP_URL=http://localhost:3000

# 64 hex characters (32 bytes) for AES-256-GCM encryption of secrets and sensitive fields.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Set to 1 only when a proxy you run sets X-Forwarded-For (used for login rate limiting).
TRUST_PROXY=0

# File storage. Only the local driver exists so far.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Email and SMS stay on the "log" fake until real sending is approved.
EMAIL_DRIVER=log
SMS_DRIVER=log

# Password given to the fictional seed logins by `npm run db:seed` (dev/test only, 10+ characters).
SEED_ADMIN_PASSWORD=CHANGE_ME
